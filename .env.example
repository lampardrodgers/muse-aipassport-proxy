# Copy to .env. Values are literal: no shell execution or variable expansion.
# Use one KEY=value per line; quote passwords containing spaces or #.
SERIAL_PORT=/dev/cu.usbmodem1101

# Optional: used only by `build-config`, never sent as a pairing token over USB.
MUSE_SDK_TOKEN=

WIFI_1_SSID=
WIFI_1_PASSWORD=
WIFI_1_PROXY_HOST=gateway
WIFI_1_PROXY_PORT=1082

WIFI_2_SSID=
WIFI_2_PASSWORD=
WIFI_2_PROXY_HOST=gateway
WIFI_2_PROXY_PORT=1082

WIFI_3_SSID=
WIFI_3_PASSWORD=
WIFI_3_PROXY_HOST=gateway
WIFI_3_PROXY_PORT=1082

WIFI_4_SSID=
WIFI_4_PASSWORD=
WIFI_4_PROXY_HOST=gateway
WIFI_4_PROXY_PORT=1082
